# ============================================================
# LexAware Student — Environment Configuration Template
# ============================================================
#
# IMPORTANT:
# - Never commit real secrets.
# - Copy this file to an appropriate local .env file.
# - Keep production secrets in the deployment secret manager.
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_ENV=development
APP_NAME=LexAware Student
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
POSTGRES_DB=lexaware
POSTGRES_USER=lexaware
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------
# Object Storage
# ------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=lexaware
S3_SECRET_KEY=change-me-minio
S3_BUCKET=lexaware-documents-private
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
MINIO_ROOT_USER=lexaware
MINIO_ROOT_PASSWORD=change-me-minio
DOCUMENT_MAX_UPLOAD_BYTES=10485760
DOCUMENT_WORKER_POLL_SECONDS=2
DOCUMENT_WORKER_MAX_ATTEMPTS=3

# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------
AUTH_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ------------------------------------------------------------
# AI Provider
# ------------------------------------------------------------
AI_PROVIDER=disabled
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_TEMPERATURE=0
GEMINI_MAX_OUTPUT_TOKENS=2048
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# ------------------------------------------------------------
# RAG
# ------------------------------------------------------------
RAG_TOP_K=10
RAG_MIN_RETRIEVAL_SCORE=0.0
RETRIEVAL_CONFIG_VERSION=hybrid-fts-vector-v2-gemini-embedding-001-768

# ------------------------------------------------------------
# Application URLs
# ------------------------------------------------------------
WEB_APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------
# Observability
# ------------------------------------------------------------
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=lexaware-api

# ------------------------------------------------------------
# Blockchain
# ------------------------------------------------------------
BLOCKCHAIN_ENABLED=false
FABRIC_GATEWAY_ENDPOINT=
FABRIC_NETWORK=
FABRIC_CHANNEL=
FABRIC_CHAINCODE=
